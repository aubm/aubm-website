---
import Icon from './Icon.astro';
import BuyOrRent from './BuyOrRent.astro';
import CampaignTrail from './CampaignTrail.astro';
import { paths, social, type Language } from '../lib/i18n';
interface Props { language: Language; piggy?: boolean; }
const { language, piggy = false } = Astro.props;
const fr = language === 'fr';
---
<section class="page-intro"><p class="eyebrow">{fr ? 'APPRENDRE EN CONSTRUISANT' : 'LEARNING BY BUILDING'}</p><h1>{piggy ? <>Piggy<span class="coral">.</span></> : fr ? <>Des idées aux <em>projets.</em></> : <>From ideas to <em>actual things.</em></>}</h1><p>{piggy ? fr ? 'Mieux comprendre ses finances personnelles, un outil à la fois.' : 'Making sense of personal finances, one useful tool at a time.' : fr ? 'Des outils utiles, des expériences et des questions qui donnent envie de construire.' : 'Useful tools, experiments, and questions that are worth building something for.'}</p></section>
<section class="project-feature"><div class="project-feature-image"><img src="/images/piggy.png" alt="Piggy" width="600" height="600" /><span class="project-feature-brand">piggy</span></div><div><p class="eyebrow">{fr ? 'LOGICIEL PERSONNEL · FINANCES' : 'PERSONAL SOFTWARE · FINANCE'}</p><h2>{fr ? 'Votre argent, un peu plus lisible.' : 'Your money, a little easier to understand.'}</h2><p>{fr ? 'Je développe et maintiens Piggy, une application de finances personnelles qui transforme les données de Google Sheets en une vue plus claire des budgets, des prévisions de trésorerie et de la progression des investissements.' : 'I build and maintain Piggy, a personal finance app that turns Google Sheets entries into a clearer view of budgets, cash forecasts, and investment progress.'}</p><p>{fr ? 'Elle réunit deux choses que j’aime : créer des logiciels utiles et comprendre nos décisions autour de l’argent.' : 'It brings together two things I enjoy: building useful software and understanding how we make decisions about money.'}</p><div class="button-row"><a class="button button-dark" href={social.piggy}>{fr ? 'Découvrir Piggy' : 'Visit Piggy'}<Icon name="external" /></a>{!piggy && <a class="text-link" href={paths.piggy[language]}>{fr ? 'L’histoire du projet' : 'The project story'}<Icon name="arrow" /></a>}</div></div></section>
{piggy ? <>
  <section class="section narrow-section"><p class="eyebrow">{fr ? 'LE POINT DE DÉPART' : 'WHERE IT STARTED'}</p><h2>{fr ? 'Une question personnelle. Un projet logiciel.' : 'A personal question. A software project.'}</h2><p>{fr ? 'Mon intérêt pour les finances personnelles et mon envie de construire se sont rejoints dans un même projet. J’en raconte les débuts dans un article, avec les premières expérimentations et les habitudes qui l’ont accompagné.' : 'My interest in personal finance and my urge to build met in the same project. I wrote about its beginnings, the early experiments, and the habits that grew alongside it.'}</p><a class="text-link" href={`${fr ? '/fr' : ''}/posts/how-my-programming-skills-helped-me-with-my-personal-finances-part-1/`}>{fr ? 'Lire l’histoire originale' : 'Read the original story'}<Icon name="arrow" /></a></section>
  <section class="outcomes-grid"><div><span>01</span><h3>{fr ? 'Le budget' : 'Budgets'}</h3><p>{fr ? 'Mieux lire les données que vous renseignez dans Google Sheets.' : 'A clearer view of the entries you keep in Google Sheets.'}</p></div><div><span>02</span><h3>{fr ? 'La trésorerie' : 'Cash forecasts'}</h3><p>{fr ? 'Regarder au-delà du solde d’aujourd’hui.' : 'A way to look beyond today’s balance.'}</p></div><div><span>03</span><h3>{fr ? 'Les investissements' : 'Investment progress'}</h3><p>{fr ? 'Suivre la progression dans une vue d’ensemble.' : 'Follow progress as part of a bigger picture.'}</p></div></section>
  <section class="small-conversation"><h2>{fr ? 'Une question sur le projet ?' : 'Curious about the project?'}</h2><a class="button button-dark" href={paths.contact[language]}>{fr ? 'Discutons' : 'Let’s talk'}<Icon name="arrow" /></a></section>
</> : <><CampaignTrail language={language} /><BuyOrRent language={language} interactive /><section class="section"><div class="section-heading"><div><p class="eyebrow">{fr ? 'DANS LA BOÎTE À OUTILS' : 'FROM THE TOOLBOX'}</p><h2>{fr ? 'Du code à partager.' : 'Code worth sharing.'}</h2></div><a class="text-link" href={social.github}>GitHub<Icon name="external" /></a></div><div class="open-source-grid"><article><Icon name="code" /><span class="tag">Go · Open source</span><h3>Postmanerator</h3><p>{fr ? 'Un générateur de documentation d’API HTTP à partir de collections Postman. Un outil pour les développeurs, né d’un besoin concret.' : 'An HTTP API documentation generator from Postman collections. A developer tool built around a practical need.'}</p><a class="text-link" href="https://github.com/aubm/postmanerator">{fr ? 'Voir le dépôt' : 'View repository'}<Icon name="external" /></a></article><article><Icon name="code" /><span class="tag">Hugo · Open source</span><h3>Code Editor Theme</h3><p>{fr ? 'Un thème Hugo inspiré de l’éditeur Atom. Un ancien projet où le goût du code rencontre celui des espaces personnels sur le Web.' : 'A Hugo theme inspired by the Atom editor. An earlier project at the intersection of developer tools and personal spaces on the web.'}</p><a class="text-link" href="https://github.com/aubm/hugo-code-editor-theme">{fr ? 'Voir le dépôt' : 'View repository'}<Icon name="external" /></a></article></div></section></>}
