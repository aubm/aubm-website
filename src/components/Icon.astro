---
interface Props { name?: 'arrow' | 'external' | 'code' | 'sun' | 'dice' | 'play' | 'wave'; class?: string; }
const { name = 'arrow', class: className } = Astro.props;
---
<svg class={className} width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'arrow' && <><path d="M4 12h15M13 5l7 7-7 7" /></>}
  {name === 'external' && <><path d="M6 18 18 6M6 6h12v12" /></>}
  {name === 'code' && <><path d="m7 6-6 6 6 6M17 6l6 6-6 6M14 3l-4 18" /></>}
  {name === 'sun' && <><circle cx="12" cy="12" r="4" /><path d="M12 1v3M12 20v3M1 12h3M20 12h3M4 4l2 2M18 18l2 2M4 20l2-2M18 6l2-2" /></>}
  {name === 'dice' && <><path d="m12 2 10 6v9l-10 5-10-5V8l10-6Z" /><path d="m12 2-5 12 5 8 5-8-5-12ZM2 8l5 6h10l5-6M2 17l5-3M17 14l5 3" /></>}
  {name === 'play' && <path d="m8 4 13 8-13 8V4Z" />}
  {name === 'wave' && <><path d="m5 12 4 4M9 16l-3-7a2 2 0 0 1 3-2l3 5-2-8a2 2 0 0 1 3-1l2 9V6a2 2 0 0 1 4 0v9c0 5-3 7-7 7-3 0-5-2-7-5l-3-4a2 2 0 0 1 3-1Z" /></>}
</svg>
