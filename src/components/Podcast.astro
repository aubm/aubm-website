---
import Icon from './Icon.astro';
import { episodes } from '../data/editorial';
import { paths, labels, social, formatDate, type Language } from '../lib/i18n';
interface Props { language: Language; episodeId?: string; }
const { language, episodeId } = Astro.props;
const fr = language === 'fr';
const episode = episodes.find((item) => item.id === episodeId);
---
<section class:list={['podcast-intro', { 'has-episode': Boolean(episode) }]}><div><p class="eyebrow">{fr ? 'DES LIVRES. DE LA TECH. DES QUESTIONS.' : 'BOOKS. TECHNOLOGY. QUESTIONS.'}</p><h1>{episode ? episode.book : <>Revues<br />de <em>Code.</em></>}</h1><p class="large-copy">{episode ? episode.title[language] : fr ? 'Des livres, de la tech et ce qu’ils changent.' : 'Books, technology, and what they change.'}</p><p>{episode ? episode.summary[language] : fr ? 'Mon podcast en français sur les livres de technologie et les questions qu’ils soulèvent autour de l’innovation, du travail et de la société.' : 'My French-language podcast about technology books and the questions they raise about innovation, work, and society.'}</p><span class="audio-language">{fr ? 'Audio en français · Résumés en français et en anglais' : 'French audio · Summaries in English and French'}</span><div class="button-row"><a class="button button-dark" href={episode?.url || social.apple}><Icon name="play" />{episode ? labels[language].listen : 'Apple Podcasts'}</a>{!episode && <a class="text-link" href={social.podbean}>Podbean<Icon name="external" /></a>}</div></div><div class="podcast-cover"><img src="/images/podcast.jpg" alt={fr ? 'Pochette officielle de Revues de Code' : 'Official Revues de Code cover art'} width="600" height="600" /><span class="cover-note">{fr ? 'Une lecture personnelle entre les lignes.' : 'A personal reading between the lines.'}</span></div></section>
{episode ? <section class="section episode-content"><div><p class="eyebrow">{fr ? 'DANS CET ÉPISODE' : 'IN THIS EPISODE'}</p><h2>{fr ? 'Quelques questions à explorer.' : 'A few questions to explore.'}</h2><ul class="question-list">{episode.questions[language].map((question) => <li><Icon name="arrow" />{question}</li>)}</ul>{episode.adaptation && <div class="adaptation-callout"><span class="tag">EN · {fr ? 'Adaptation écrite' : 'Written adaptation'}</span><h3>{fr ? 'Vous préférez lire ?' : 'Prefer to read?'}</h3><p>{fr ? 'Une adaptation en anglais de cet épisode est disponible sur Medium.' : 'An English written adaptation of this episode is available on Medium.'}</p><a class="text-link" href={episode.adaptation}>{fr ? 'Lire sur Medium' : 'Read on Medium'}<Icon name="external" /></a></div>}<a class="text-link" href={paths.contact[language]}>{fr ? 'Discuter de cet épisode' : 'Discuss this episode'}<Icon name="arrow" /></a></div><aside class="episode-details"><h3>{fr ? 'Le livre' : 'The book'}</h3><p>{episode.book}<br /><strong>{episode.author}</strong></p><h3>{fr ? 'Publication de l’épisode' : 'Episode published'}</h3><p>{formatDate(episode.date, language)}</p><h3>{fr ? 'Langue audio' : 'Audio language'}</h3><p>{fr ? 'Français' : 'French'}</p><a class="text-link" href={paths.podcast[language]}>{fr ? 'Tous les épisodes' : 'All episodes'}<Icon name="arrow" /></a></aside></section> : <section class="section"><div class="section-heading"><div><p class="eyebrow">{fr ? 'À ÉCOUTER' : 'ON THE BOOKSHELF'}</p><h2>{fr ? 'Les épisodes.' : 'The episodes.'}</h2></div><span class="muted">{fr ? 'Au rythme des idées.' : 'At the pace of good ideas.'}</span></div><div class="episode-list">{episodes.map((item) => <article><span class="episode-number">{item.number}</span><div><p class="eyebrow">{item.author} · <time datetime={item.date}>{formatDate(item.date, language)}</time></p><h3><a href={`${paths.podcast[language]}${item.id}/`}>{item.book}</a></h3><p>{item.summary[language]}</p><span class="language-label">{fr ? 'Audio : français' : 'Audio: French'}</span></div><a class="round-link" href={`${paths.podcast[language]}${item.id}/`} aria-label={`${fr ? 'Découvrir' : 'Explore'} ${item.book}`}><Icon name="arrow" /></a></article>)}</div></section>}
